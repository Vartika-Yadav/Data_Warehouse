USE silver;

TRUNCATE TABLE silver.crm_sales_details;

INSERT INTO silver.crm_sales_details (
    sls_ord_num,
    sls_prd_key,
    sls_cust_id,
    sls_order_dt,
    sls_ship_dt,
    sls_due_dt,
    sls_sales,
    sls_quantity,
    sls_price
)
SELECT
    TRIM(sls_ord_num) AS sls_ord_num,

    TRIM(sls_prd_key) AS sls_prd_key,

    CASE
        WHEN TRIM(sls_cust_id) = ''
          OR sls_cust_id IS NULL
        THEN NULL
        ELSE CAST(sls_cust_id AS UNSIGNED)
    END AS sls_cust_id,

    CASE
        WHEN TRIM(sls_order_dt) = ''
          OR sls_order_dt IS NULL
          OR CHAR_LENGTH(TRIM(sls_order_dt)) <> 8
          OR TRIM(sls_order_dt) = '0'
        THEN NULL
        ELSE STR_TO_DATE(TRIM(sls_order_dt), '%Y%m%d')
    END AS sls_order_dt,

    CASE
        WHEN TRIM(sls_ship_dt) = ''
          OR sls_ship_dt IS NULL
          OR CHAR_LENGTH(TRIM(sls_ship_dt)) <> 8
          OR TRIM(sls_ship_dt) = '0'
        THEN NULL
        ELSE STR_TO_DATE(TRIM(sls_ship_dt), '%Y%m%d')
    END AS sls_ship_dt,

    CASE
        WHEN TRIM(sls_due_dt) = ''
          OR sls_due_dt IS NULL
          OR CHAR_LENGTH(TRIM(sls_due_dt)) <> 8
          OR TRIM(sls_due_dt) = '0'
        THEN NULL
        ELSE STR_TO_DATE(TRIM(sls_due_dt), '%Y%m%d')
    END AS sls_due_dt,

    CASE
        WHEN TRIM(sls_sales) = ''
          OR sls_sales IS NULL
          OR CAST(sls_sales AS SIGNED) <= 0
          OR CAST(sls_sales AS SIGNED) <>
             CAST(sls_quantity AS SIGNED) * ABS(CAST(sls_price AS SIGNED))
        THEN
            CAST(sls_quantity AS SIGNED) *
            ABS(CAST(sls_price AS SIGNED))
        ELSE
            CAST(sls_sales AS SIGNED)
    END AS sls_sales,

    CASE
        WHEN TRIM(sls_quantity) = ''
          OR sls_quantity IS NULL
        THEN 0
        ELSE CAST(sls_quantity AS SIGNED)
    END AS sls_quantity,

    CASE
        WHEN TRIM(sls_price) = ''
          OR sls_price IS NULL
          OR CAST(sls_price AS SIGNED) <= 0
        THEN
            CASE
                WHEN CAST(sls_quantity AS SIGNED) <> 0
                THEN
                    CAST(sls_sales AS SIGNED) /
                    CAST(sls_quantity AS SIGNED)
                ELSE 0
            END
        ELSE
            CAST(sls_price AS SIGNED)
    END AS sls_price

FROM bronze.crm_sales_details;

